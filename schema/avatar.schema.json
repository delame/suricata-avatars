{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Suricata Sentinel Live avatar",
  "definitions": {
    "text": { "type": "object", "required": ["en", "pl"], "additionalProperties": { "type": "string", "minLength": 1 } },
    "names": { "type": "object", "required": ["default"], "additionalProperties": { "type": "string", "minLength": 1 } },
    "common": {
      "type": "object",
      "required": ["id", "kind", "status", "version", "naming", "names", "title", "job", "defaultEnabled", "models", "tone", "look", "voice"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
        "status": { "enum": ["concept", "testing", "live", "retired"] },
        "version": { "type": "integer", "minimum": 1 },
        "names": { "$ref": "#/definitions/names" },
        "title": { "$ref": "#/definitions/text" },
        "job": { "$ref": "#/definitions/text" },
        "defaultEnabled": { "type": "boolean" },
        "models": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "tone": { "type": "string", "minLength": 1 },
        "look": { "type": ["string", "null"] },
        "voice": { "type": ["string", "null"] },
        "rules": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "allOf": [{ "$ref": "#/definitions/common" }],
  "oneOf": [
    {
      "properties": {
        "kind": { "const": "role" },
        "naming": { "const": "global" },
        "nameOrigin": { "type": "string", "minLength": 1 },
        "handles": { "type": "array", "minItems": 1, "items": { "enum": ["opinion", "fallback", "summary", "pending", "unverifiable", "uncertainty", "correction"] } }
      },
      "required": ["nameOrigin", "handles"]
    },
    {
      "properties": {
        "kind": { "const": "expert" },
        "naming": { "const": "localized" },
        "domains": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z-]+$" } },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/text" } },
        "evidencePolicy": {
          "type": "object",
          "required": ["minSources", "primarySourcesRequired", "maxAgeDays"],
          "properties": { "minSources": { "type": "integer", "minimum": 1 }, "primarySourcesRequired": { "type": "boolean" }, "maxAgeDays": { "type": "integer", "minimum": 1 } }
        }
      },
      "required": ["domains", "sources", "evidencePolicy"]
    }
  ]
}
